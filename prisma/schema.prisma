// Prisma Schema for Kolabri Core API
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  student
  lecturer
  admin
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String
  role                 UserRole  @default(student)
  googleId             String?   @unique @map("google_id")
  avatarUrl            String?   @map("avatar_url")
  isActive             Boolean   @default(true) @map("is_active")
  emailVerifiedAt      DateTime? @map("email_verified_at")
  themePreference      String?   @default("system") @map("theme_preference") // "light" | "dark" | "system"
  languagePreference   String?   @default("id") @map("language_preference") // "id" | "en"
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  // Relations
  ownedCourses     Course[]            @relation("CourseOwner")
  archivedCourses  Course[]            @relation("ArchivedCourses")
  createdTemplates CourseTemplate[]
  enrolledCourses  CourseStudent[]
  groupMembers     GroupMember[]
  learningGoals    LearningGoal[]
  reflections      Reflection[]
  knowledgeBases   KnowledgeBase[]
  chatMessages     ChatMessage[]
  aiChats          AiChat[]
  aiUsages         AiUsage[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  exportJobs             ExportJob[]
  sessionDiscussionPreReadCompletions SessionDiscussionPreReadCompletion[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

// ============================================
// COURSE MANAGEMENT
// ============================================

model Course {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  description  String?
  joinCode     String    @unique @map("join_code")
  minMembersPerGroup Int @default(1) @map("min_members_per_group")
  maxMembersPerGroup Int @default(8) @map("max_members_per_group")
  aiGuardrailConfig Json? @map("ai_guardrail_config")
  aiScaffoldingConfig Json? @map("ai_scaffolding_config")
  aiEscalationConfig Json? @map("ai_escalation_config")
  semester     String?   // "Ganjil" | "Genap"
  academicYear String?   @map("academic_year") // e.g. "2024/2025"
  isActive     Boolean   @default(true) @map("is_active")
  isArchived   Boolean   @default(false) @map("is_archived")
  archivedAt   DateTime? @map("archived_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Owner (Lecturer)
  ownerId String @map("owner_id")
  owner   User   @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  archivedById String? @map("archived_by_id")
  archivedBy   User?   @relation("ArchivedCourses", fields: [archivedById], references: [id], onDelete: SetNull)

  // Relations
  students       CourseStudent[]
  groups         Group[]
  knowledgeBases KnowledgeBase[]
  aiUsages       AiUsage[]
  courseWeeks    CourseWeek[]
  courseMaterials CourseMaterial[]
  reflections     Reflection[]

  @@index([ownerId])
  @@index([code])
  @@index([isActive])
  @@index([isArchived])
  @@index([createdAt])
  @@index([ownerId, isActive])
  @@index([deletedAt])
  @@map("courses")
}

model CourseTemplate {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  namePattern         String   @map("name_pattern")
  descriptionTemplate String?  @map("description_template")
  defaultGroups       Json     @map("default_groups")
  createdById         String   @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([createdAt])
  @@map("course_templates")
}

model CourseStudent {
  id         String   @id @default(uuid())
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  // Relations
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@map("course_students")
}

// ============================================
// GROUP MANAGEMENT
// ============================================

model Group {
  id        String    @id @default(uuid())
  name      String
  joinCode  String    @unique @map("join_code")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Creator (can be lecturer or student)
  createdBy String @map("created_by")

  // Relations
  courseId   String        @map("course_id")
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members    GroupMember[]
  sessionDiscussions SessionDiscussion[]

  @@index([courseId])
  @@index([deletedAt])
  @@index([courseId, deletedAt])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(uuid())
  joinedAt DateTime @default(now()) @map("joined_at")

  // Relations
  groupId String @map("group_id")
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

// ============================================
// SESSION DISCUSSIONS (Multiple discussion sessions per group)
// ============================================

model SessionDiscussion {
  id          String    @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Classification
  type     String?   @map("type")     // 'Akademik' | 'Proyek' | 'Umum'

  // Session closure
  closedAt DateTime? @map("closed_at")
  closedBy String?   @map("closed_by")
  summary  String?   @db.Text @map("summary")
  summaryGeneratedAt DateTime? @map("summary_generated_at")
  /// Penilaian capaian tujuan (goalAchieved/topics/contributions/assessment)
  /// dihasilkan sekali di server saat sesi ditutup — client tak memanggil
  /// endpoint direction/summary (dosen-only, P2-04).
  goalAssessment Json? @map("goal_assessment")

  // Creator
  createdBy String @map("created_by")

  // Course week (Laravel course_weeks.id — opaque UUID, no FK)
  weekId String? @map("week_id")

  // Relations
  groupId              String                        @map("group_id")
  group                Group                         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages             ChatMessage[]
  goals                LearningGoal[]
  reflections          Reflection[]
  preReadCompletions   SessionDiscussionPreReadCompletion[]

  @@index([groupId])
  @@index([weekId])
  @@index([deletedAt])
  @@index([groupId, deletedAt])
  @@index([groupId, type])
  @@map("session_discussions")
}

model SessionDiscussionPreReadCompletion {
  id          String   @id @default(uuid())
  completedAt DateTime @default(now()) @map("completed_at")

  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionDiscussionId String    @map("session_discussion_id")
  sessionDiscussion   SessionDiscussion @relation(fields: [sessionDiscussionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionDiscussionId])
  @@index([sessionDiscussionId])
  @@map("session_discussion_pre_read_completions")
}

model ChatMessage {
  id             String   @id @default(uuid())
  content        String
  senderType     String   @map("sender_type") // 'user' | 'ai' | 'bot'
  isIntervention Boolean  @default(false) @map("is_intervention")
  createdAt      DateTime @default(now()) @map("created_at")

  // Reply to another message
  replyToId String?       @map("reply_to_id")
  replyTo   ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("MessageReplies")

  // Topic / thread / pin for search & organization (fr-disc-08)
  topic     String?  @map("topic")
  threadId  String?  @map("thread_id")
  isPinned  Boolean  @default(false) @map("is_pinned")
  pinnedAt  DateTime? @map("pinned_at")
  pinnedBy  String?  @map("pinned_by")

  /// AI scaffolding citations: [{ course_material_id, label?, page? }]
  citations Json? @map("citations")

  // Relations
  sessionDiscussionId String    @map("session_discussion_id")
  sessionDiscussion   SessionDiscussion @relation(fields: [sessionDiscussionId], references: [id], onDelete: Cascade)
  senderId    String    @map("sender_id")
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sessionDiscussionId])
  @@index([senderId])
  @@index([sessionDiscussionId, createdAt])
  @@index([sessionDiscussionId, isPinned, createdAt])
  @@map("chat_messages")
}

// ============================================
// LEARNING GOALS & REFLECTIONS
// ============================================

model LearningGoal {
  id          String   @id @default(uuid())
  content     String
  isValidated Boolean  @default(false) @map("is_validated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations - Goal belongs to a SessionDiscussion, not Group
  sessionDiscussionId String       @map("session_discussion_id")
  sessionDiscussion   SessionDiscussion    @relation(fields: [sessionDiscussionId], references: [id], onDelete: Cascade)
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflections Reflection[]

  @@index([sessionDiscussionId])
  @@index([userId])
  @@index([sessionDiscussionId, userId])
  @@map("learning_goals")
}

model Reflection {
  id        String   @id @default(uuid())
  content   String
  type      String   @default("session") // 'session' | 'weekly'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  goalId      String?       @map("goal_id")
  goal        LearningGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionDiscussionId String?       @map("session_discussion_id")
  sessionDiscussion   SessionDiscussion?    @relation(fields: [sessionDiscussionId], references: [id], onDelete: SetNull)
  courseId    String?       @map("course_id")
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([goalId])
  @@index([sessionDiscussionId, userId])
  @@index([courseId, userId])
  @@index([userId, createdAt])
  @@map("reflections")
}

// ============================================
// KNOWLEDGE BASE
// ============================================

enum VectorStatus {
  pending
  processing
  ready
  failed
  skipped
}

model KnowledgeBase {
  id           String       @id @default(uuid())
  fileName     String       @map("file_name")
  filePath     String       @map("file_path")
  fileSize     Int          @map("file_size")
  mimeType     String       @map("mime_type")
  vectorStatus VectorStatus @default(pending) @map("vector_status")
  errorMessage String?      @map("error_message")
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")
  processedAt  DateTime?    @map("processed_at")
  deletedAt    DateTime?    @map("deleted_at")

  weekIndex        Int?    @map("week_index")
  weekId           String? @map("week_id")
  courseMaterialId String? @map("course_material_id")

  // Relations
  courseId   String @map("course_id")
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy String @map("uploaded_by")
  uploader   User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([uploadedBy])
  @@index([deletedAt])
  @@index([courseId, weekIndex])
  @@index([courseMaterialId])
  @@map("knowledge_bases")
}

// ============================================
// AI CHAT (Personal AI Assistant for Students)
// ============================================

model AiChat {
  id        String   @id @default(uuid())
  title     String   @default("Chat Baru")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  userId   String          @map("user_id")
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId])
  @@map("ai_chats")
}

model AiChatMessage {
  id        String   @id @default(uuid())
  role      String // 'user' | 'assistant'
  content   String
  /// AI RAG citations: [{ source, page?, course_id?, course_material_id? }]
  citations Json? @map("citations")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  chatId String @map("chat_id")
  chat   AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([chatId, createdAt])
  @@map("ai_chat_messages")
}

// ============================================
// AI PROVIDER SETTINGS (Admin Configuration)
// ============================================

model AiProvider {
  id            String   @id @default(uuid())
  name          String   @unique // "openai", "anthr0pic", "google", etc.
  displayName   String   @map("display_name") // "0penAI", "", "Google Gemini"
  apiKey        String   @map("api_key") // Encrypted API key
  baseUrl       String?  @map("base_url") // Optional custom base URL
  isActive      Boolean  @default(false) @map("is_active")
  fallbackOrder Int      @default(0) @map("fallback_order")
  config        Json? // Additional config (model list, parameters, etc.)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  usages            AiUsage[]

  @@index([isActive, fallbackOrder])
  @@map("ai_providers")
}

model AiUsage {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  courseId         String?  @map("course_id")
  provider         String
  providerId       String?  @map("provider_id")
  model            String
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  estimatedCost    Float    @map("estimated_cost")
  latencyMs        Int      @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  providerRef AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@index([provider, createdAt])
  @@map("ai_usages")
}


model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  userId     String   @map("user_id")
  changes    Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// PASSWORD RESET & EMAIL VERIFICATION
// ============================================

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  info
  success
  warning
  error
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType @default(info)
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model EscalationState {
  id              String   @id @default(uuid())
  courseId        String   @map("course_id")
  groupId         String   @map("group_id")
  sessionDiscussionId     String   @map("session_discussion_id")
  issueType       String   @map("issue_type")
  currentStage    String   @map("current_stage")
  history         Json     @default("[]")
  lastCheckedAt   DateTime @map("last_checked_at")
  resolvedAt      DateTime? @map("resolved_at")
  resolvedBy      String?  @map("resolved_by")
  notificationSentAt DateTime? @map("notification_sent_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([courseId, currentStage])
  @@index([groupId, currentStage])
  @@index([sessionDiscussionId, issueType, currentStage])
  @@map("escalation_states")
}

model ExportJob {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  exportType  String   @map("export_type") // 'USER_DATA' | 'COURSE_DATA'
  courseId    String?  @map("course_id")
  status      String   @default("pending") // 'pending' | 'processing' | 'completed' | 'failed' | 'expired'
  filePath    String?  @map("file_path")
  createdAt   DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("export_jobs")
}

// ============================================
// ============================================
// COURSE WEEKS & MATERIALS
// ============================================

model CourseWeek {
  id         String   @id
  courseId   String   @map("course_id")
  weekIndex  Int      @map("week_index")
  title      String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials  CourseWeekMaterial[]

  @@unique([courseId, weekIndex])
  @@map("course_weeks")
}

model CourseWeekMaterial {
  id               String   @id
  courseWeekId     String   @map("course_week_id")
  courseMaterialId String   @map("course_material_id")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  courseWeek       CourseWeek    @relation(fields: [courseWeekId], references: [id], onDelete: Cascade)
  material         CourseMaterial @relation(fields: [courseMaterialId], references: [id], onDelete: Cascade)

  @@unique([courseWeekId, courseMaterialId])
  @@index([courseWeekId, sortOrder])
  @@map("course_week_materials")
}

model CourseMaterial {
  id          String   @id
  courseId    String   @map("course_id")
  title       String
  description String?
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  fileType    String?  @map("file_type")
  fileSize    Int      @default(0) @map("file_size")
  uploadedBy  String?  @map("uploaded_by")
  viewCount   Int      @default(0) @map("view_count")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  weekLinks   CourseWeekMaterial[]

  @@index([courseId])
  @@map("course_materials")
}

// ============================================
// ATTENDANCE (tables created by Laravel migrations)
// ============================================

model AttendanceSession {
  id                    String              @id @default(uuid())
  courseId              String              @map("course_id")
  sessionDiscussionId   String?             @unique @map("session_discussion_id")
  weekId                String?             @map("week_id")
  groupId               String?             @map("group_id")
  title                 String
  sessionDate           DateTime            @map("session_date")
  sessionNumber         Int?                @map("session_number")
  autoGenerated         Boolean             @default(false) @map("auto_generated")
  attendanceMethod      String              @default("auto") @map("attendance_method")
  notes                 String?
  createdBy             String?             @map("created_by")
  totalStudents         Int                 @default(0) @map("total_students")
  presentCount          Int                 @default(0) @map("present_count")
  absentCount           Int                 @default(0) @map("absent_count")
  excusedCount          Int                 @default(0) @map("excused_count")
  markedCount           Int                 @default(0) @map("marked_count")
  attendanceRate        Float               @default(0) @map("attendance_rate")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  records               AttendanceRecord[]

  @@index([courseId])
  @@index([weekId])
  @@index([groupId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  studentId     String   @map("student_id")
  studentName   String?  @map("student_name")
  studentEmail  String?  @map("student_email")
  status        String
  notes         String?
  markedAt      DateTime? @map("marked_at")
  markedBy      String?   @map("marked_by")

  session       AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId, sessionId])
  @@map("attendance_records")
}
