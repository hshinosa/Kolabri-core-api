// Prisma Schema for Kolabri Core API
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  student
  lecturer
  admin
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      UserRole  @default(student)
  googleId  String?   @unique @map("google_id")
  avatarUrl String?   @map("avatar_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  ownedCourses     Course[]            @relation("CourseOwner")
  archivedCourses  Course[]            @relation("ArchivedCourses")
  createdTemplates CourseTemplate[]
  enrolledCourses  CourseStudent[]
  groupMembers     GroupMember[]
  learningGoals    LearningGoal[]
  reflections      Reflection[]
  knowledgeBases   KnowledgeBase[]
  chatMessages     ChatMessage[]
  aiChats          AiChat[]
  aiUsages         AiUsage[]
  aiComparisons    AiModelComparison[]
  auditLogs        AuditLog[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

// ============================================
// COURSE MANAGEMENT
// ============================================

model Course {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  joinCode    String    @unique @map("join_code")
  isActive    Boolean   @default(true) @map("is_active")
  isArchived  Boolean   @default(false) @map("is_archived")
  archivedAt  DateTime? @map("archived_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Owner (Lecturer)
  ownerId String @map("owner_id")
  owner   User   @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  archivedById String? @map("archived_by_id")
  archivedBy   User?   @relation("ArchivedCourses", fields: [archivedById], references: [id], onDelete: SetNull)

  // Relations
  students       CourseStudent[]
  groups         Group[]
  knowledgeBases KnowledgeBase[]
  aiUsages       AiUsage[]

  @@index([ownerId])
  @@index([code])
  @@index([isActive])
  @@index([isArchived])
  @@index([createdAt])
  @@index([ownerId, isActive])
  @@index([deletedAt])
  @@map("courses")
}

model CourseTemplate {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  namePattern         String   @map("name_pattern")
  descriptionTemplate String?  @map("description_template")
  defaultGroups       Json     @map("default_groups")
  createdById         String   @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([createdAt])
  @@map("course_templates")
}

model CourseStudent {
  id         String   @id @default(uuid())
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  // Relations
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@map("course_students")
}

// ============================================
// GROUP MANAGEMENT
// ============================================

model Group {
  id        String    @id @default(uuid())
  name      String
  joinCode  String    @unique @map("join_code")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Creator (can be lecturer or student)
  createdBy String @map("created_by")

  // Relations
  courseId   String        @map("course_id")
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members    GroupMember[]
  chatSpaces ChatSpace[]

  @@index([courseId])
  @@index([deletedAt])
  @@index([courseId, deletedAt])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(uuid())
  joinedAt DateTime @default(now()) @map("joined_at")

  // Relations
  groupId String @map("group_id")
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

// ============================================
// CHAT SPACES (Multiple chat rooms per group)
// ============================================

model ChatSpace {
  id          String    @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Session closure
  closedAt DateTime? @map("closed_at")
  closedBy String?   @map("closed_by")
  summary  String?   @db.Text @map("summary")
  summaryGeneratedAt DateTime? @map("summary_generated_at")

  // Creator
  createdBy String @map("created_by")

  // Relations
  groupId     String         @map("group_id")
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  goals       LearningGoal[]
  reflections Reflection[]

  @@index([groupId])
  @@index([deletedAt])
  @@index([groupId, deletedAt])
  @@map("chat_spaces")
}

model ChatMessage {
  id             String   @id @default(uuid())
  content        String
  senderType     String   @map("sender_type") // 'user' | 'ai' | 'bot'
  isIntervention Boolean  @default(false) @map("is_intervention")
  createdAt      DateTime @default(now()) @map("created_at")

  // Reply to another message
  replyToId String?       @map("reply_to_id")
  replyTo   ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("MessageReplies")

  // Relations
  chatSpaceId String    @map("chat_space_id")
  chatSpace   ChatSpace @relation(fields: [chatSpaceId], references: [id], onDelete: Cascade)
  senderId    String    @map("sender_id")
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatSpaceId])
  @@index([senderId])
  @@index([chatSpaceId, createdAt])
  @@map("chat_messages")
}

// ============================================
// LEARNING GOALS & REFLECTIONS
// ============================================

model LearningGoal {
  id          String   @id @default(uuid())
  content     String
  isValidated Boolean  @default(false) @map("is_validated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations - Goal belongs to a ChatSpace, not Group
  chatSpaceId String       @map("chat_space_id")
  chatSpace   ChatSpace    @relation(fields: [chatSpaceId], references: [id], onDelete: Cascade)
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflections Reflection[]

  @@index([chatSpaceId])
  @@index([userId])
  @@index([chatSpaceId, userId])
  @@map("learning_goals")
}

model Reflection {
  id        String   @id @default(uuid())
  content   String
  type      String   @default("session") // 'session' | 'weekly'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  goalId      String?       @map("goal_id")
  goal        LearningGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSpaceId String?       @map("chat_space_id")
  chatSpace   ChatSpace?    @relation(fields: [chatSpaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([goalId])
  @@index([chatSpaceId, userId])
  @@index([userId, createdAt])
  @@map("reflections")
}

// ============================================
// KNOWLEDGE BASE
// ============================================

enum VectorStatus {
  pending
  processing
  ready
  failed
  skipped
}

model KnowledgeBase {
  id           String       @id @default(uuid())
  fileName     String       @map("file_name")
  filePath     String       @map("file_path")
  fileSize     Int          @map("file_size")
  mimeType     String       @map("mime_type")
  vectorStatus VectorStatus @default(pending) @map("vector_status")
  errorMessage String?      @map("error_message")
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")
  processedAt  DateTime?    @map("processed_at")
  deletedAt    DateTime?    @map("deleted_at")

  // Relations
  courseId   String @map("course_id")
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy String @map("uploaded_by")
  uploader   User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([uploadedBy])
  @@index([deletedAt])
  @@map("knowledge_bases")
}

// ============================================
// AI CHAT (Personal AI Assistant for Students)
// ============================================

model AiChat {
  id        String   @id @default(uuid())
  title     String   @default("Chat Baru")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  userId   String          @map("user_id")
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId])
  @@map("ai_chats")
}

model AiChatMessage {
  id        String   @id @default(uuid())
  role      String // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  chatId String @map("chat_id")
  chat   AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([chatId, createdAt])
  @@map("ai_chat_messages")
}

// ============================================
// AI PROVIDER SETTINGS (Admin Configuration)
// ============================================

model AiProvider {
  id            String   @id @default(uuid())
  name          String   @unique // "openai", "anthr0pic", "google", etc.
  displayName   String   @map("display_name") // "0penAI", "", "Google Gemini"
  apiKey        String   @map("api_key") // Encrypted API key
  baseUrl       String?  @map("base_url") // Optional custom base URL
  isActive      Boolean  @default(false) @map("is_active")
  fallbackOrder Int      @default(0) @map("fallback_order")
  config        Json? // Additional config (model list, parameters, etc.)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  usages            AiUsage[]
  comparisonResults AiModelComparisonResult[]

  @@index([isActive, fallbackOrder])
  @@map("ai_providers")
}

model AiUsage {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  courseId         String?  @map("course_id")
  provider         String
  providerId       String?  @map("provider_id")
  model            String
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  estimatedCost    Float    @map("estimated_cost")
  latencyMs        Int      @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  providerRef AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@index([provider, createdAt])
  @@map("ai_usages")
}

model AiModelComparison {
  id        String   @id @default(uuid())
  prompt    String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  creator User                      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  results AiModelComparisonResult[]

  @@index([createdBy, createdAt])
  @@map("ai_model_comparisons")
}

model AiModelComparisonResult {
  id               String   @id @default(uuid())
  comparisonId     String   @map("comparison_id")
  provider         String
  providerId       String?  @map("provider_id")
  model            String
  response         String
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  estimatedCost    Float    @map("estimated_cost")
  latencyMs        Int      @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  comparison  AiModelComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  providerRef AiProvider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([comparisonId])
  @@index([provider, model])
  @@map("ai_model_comparison_results")
}

// ============================================
// AUDIT LOGS (Admin Actions)
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  userId     String   @map("user_id")
  changes    Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
