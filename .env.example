# Kolabri Core API Environment Variables
# Copy this file to .env and fill in the values.
# All variables marked REQUIRED are validated at boot; the process exits with
# a descriptive error if any required var is missing or malformed.

# Server
NODE_ENV=development                # one of: development | test | production
PORT=3000

# PostgreSQL Database (REQUIRED)
DATABASE_URL="postgresql://postgres:123hshi@localhost:5432/kolabri-db?schema=public"

# MongoDB (REQUIRED, used for chat logs and activity logs)
MONGODB_URL="mongodb://localhost:27017/kolabri"

# JWT Configuration (REQUIRED, JWT_SECRET >= 32 chars)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="1d"          # Access token lifetime (e.g. 15m, 1h, 1d). Refresh token is fixed at 7d in code.
# Optional separate refresh secret. Defaults to JWT_SECRET. Min 32 chars when set.
# JWT_REFRESH_SECRET=""

# AI Engine URL (REQUIRED, must be a valid URL)
AI_ENGINE_URL="http://localhost:8001"
AI_ENGINE_SECRET=""
# Laravel BFF internal hooks (queue/link KB). Prefer this name; falls back to AI_ENGINE_SECRET.
CORE_API_INTERNAL_SECRET=""

# Webhook shared secret (REQUIRED, >= 16 chars)
CORE_API_SECRET="shared-secret-key-min-16-chars"

# Client App URL (for CORS, must be a valid URL)
CLIENT_URL="http://localhost:8080"

# Encryption key for at-rest secrets (optional; must be exactly 32 chars when set)
# ENCRYPTION_KEY=""

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Redis (optional, for production scalability)
# REDIS_URL="redis://localhost:6379"
