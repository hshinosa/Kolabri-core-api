{
  "name": "kolabri-core-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Kolabri Core API - Express.js Backend for Collaborative Learning Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:populate": "tsx prisma/scripts/populate-analytics-data.ts && tsx prisma/scripts/populate-chatlogs.ts",
    "db:verify-populate": "tsx prisma/scripts/verify-populate-data.ts",
    "db:reset:populate": "prisma migrate reset --force --skip-seed && prisma db push && tsx prisma/scripts/populate-analytics-data.ts && tsx prisma/scripts/populate-chatlogs.ts && tsx prisma/scripts/verify-populate-data.ts",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "kolabri",
    "education",
    "collaborative-learning",
    "express",
    "typescript"
  ],
  "author": "Kolabri Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/ws": "^8.18.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.35.0",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.1",
    "undici": "^7.16.0",
    "uuid": "^14.0.0",
    "winston": "^3.17.0",
    "ws": "^8.20.0",
    "xss": "^1.0.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/form-data": "^2.2.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
