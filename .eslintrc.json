{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "MemberExpression[object.name='req'][property.name='body']",
        "message": "Direct access to req.body is forbidden. Use validated types from middleware instead."
      },
      {
        "selector": "MemberExpression[object.name='req'][property.name='params']",
        "message": "Direct access to req.params is forbidden. Use validated types from middleware instead."
      },
      {
        "selector": "MemberExpression[object.name='req'][property.name='query']",
        "message": "Direct access to req.query is forbidden. Use validated types from middleware instead."
      }
    ]
  },
  "ignorePatterns": ["dist", "node_modules", "*.test.ts", "*.integration.test.ts"]
}
