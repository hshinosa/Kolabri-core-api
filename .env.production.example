# Kolabri Core API - Production Environment
# Copy to .env.production and update values

# Server
PORT=3000
NODE_ENV=production

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:your-strong-password@postgres:5432/kolabri-db?schema=public"

# MongoDB (for chat logs, activity logs)
MONGODB_URL="mongodb://mongodb:27017/kolabri"

# JWT Configuration
JWT_SECRET="change-this-to-very-long-random-string-in-production-min-32-chars"
JWT_EXPIRES_IN="1d"

# AI Engine URL
AI_ENGINE_URL="http://ai-engine:8001"
AI_ENGINE_SECRET="change-this-to-strong-secret-in-production"

# Client App URL (for CORS) - update with your domain
CLIENT_URL="https://your-domain.com"

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10000
AUTH_RATE_LIMIT_MAX=500

# Redis
REDIS_URL="redis://redis:6379"

# Internal API Secret
CORE_API_SECRET="change-this-to-strong-secret-in-production"
ENCRYPTION_KEY="generate-32-char-random-key-for-production"
